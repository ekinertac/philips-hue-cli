def die(code, msg):
    """Print msg to stderr and exit with code."""
    print(msg, file=sys.stderr)
    sys.exit(code)


def cmd_pair(args):
    """Pair with the bridge: poll v1 POST /api until link button pressed."""
    bridge = args.bridge
    if not bridge:
        # Try discovery.meethue.com
        try:
            _, disc_resp = request("GET", "", bridge="discovery.meethue.com", key=None, timeout=args.timeout, v2=False)
            if disc_resp and isinstance(disc_resp, list) and len(disc_resp) > 0:
                bridge = disc_resp[0].get("internalipaddress")
                if not bridge:
                    bridge = disc_resp[0].get("ipaddress")
        except SystemExit:
            pass
        if not bridge:
            die(1, "No bridge found via discovery.meethue.com. Specify --bridge <IP>")

    hostname = socket.gethostname()
    devicetype = f"hue-cli@{hostname}"

    print(f"Press the link button on the bridge at {bridge}, then press Enter...", file=sys.stderr)
    input()

    deadline = time.time() + 90
    while time.time() < deadline:
        _, resp = request("POST", "", body={"devicetype": devicetype}, bridge=bridge, key=None, timeout=args.timeout, v2=False)
        if resp and isinstance(resp, list) and len(resp) > 0:
            entry = resp[0]
            if "success" in entry:
                key = entry["success"].get("username")
                if key:
                    save_config(bridge, key)
                    print(f"Paired with {bridge}. Key saved to {CONFIG_PATH}", file=sys.stderr)
                    return
            elif "error" in entry:
                err_desc = entry["error"].get("description", "")
                if "link button" in err_desc.lower():
                    print("  Link button not pressed yet...", file=sys.stderr)
                    time.sleep(2)
                else:
                    die(1, f"Pair error: {err_desc}")
        else:
            time.sleep(2)

    die(5, "Pair timed out after 90s. Press the link button and try again.")


def cmd_lights(args):
    """List all lights."""
    snap = _get_snap(args)
    rows = []
    json_rows = []
    for l in snap["lights"]:
        name = l.get("metadata", {}).get("name", "")
        if not name:
            dev_id = snap["light_device"].get(l["id"])
            dev = snap["device_by_id"].get(dev_id) if dev_id else None
            name = dev.get("product_name", "") if dev else ""
        on = get_light_on(l)
        bri = get_light_brightness(l)
        reachable = l.get("light", {}).get("is_reachable", l.get("reachable", True))
        # Find room
        room_name = ""
        for room in snap["rooms"]:
            for svc in room.get("services", []):
                if svc["rtype"] == "light" and svc["rid"] == l["id"]:
                    room_name = room.get("metadata", {}).get("name", "")
                    break

        on_str = "on" if on else "off"
        bri_str = format_bri(bri)
        reach_str = "yes" if reachable else "no"

        if args.json:
            json_rows.append({
                **trim_resource({"id": l["id"], **l}, snap),
                "reachable": reachable,
            })
        else:
            rows.append([name, on_str, bri_str, reach_str, room_name])

    if args.json:
        json_out(json_rows, args.quiet)
    else:
        fmt_table(rows, ["Name", "State", "Brightness", "Reachable", "Room"])


def cmd_rooms(args):
    """List all rooms."""
    snap = _get_snap(args)
    rows = []
    json_rows = []
    for r in snap["rooms"]:
        name = r.get("metadata", {}).get("name", "")
        gl = snap["gl_by_owner"].get(r["id"])
        light_count = len([s for s in r.get("services", []) if s["rtype"] == "light"])
        if gl:
            any_on = get_gl_on(gl)[1]
            state = "on" if any_on else "off"
        else:
            state = "-"

        if args.json:
            json_rows.append(trim_resource({"id": r["id"], **r}, snap))
        else:
            rows.append([name, str(light_count), state])

    if args.json:
        json_out(json_rows, args.quiet)
    else:
        fmt_table(rows, ["Name", "Lights", "State"])


def cmd_scenes(args):
    """List all scenes, optionally filtered by room."""
    snap = _get_snap(args)
    room_filter = args.room.lower() if args.room else None

    # Group scenes by room
    scenes_by_room = {}
    for s in snap["scenes"]:
        group = s.get("group", {})
        room_id = group.get("rid")
        room = snap["rid_index"].get(room_id) if room_id else None
        room_name = room.get("metadata", {}).get("name", "Unknown") if room else "Unknown"

        if room_filter and room_name.lower() != room_filter:
            continue

        sname = s.get("metadata", {}).get("name", "")
        scenes_by_room.setdefault(room_name, []).append(sname)

    if args.json:
        items = []
        for room_name, scene_names in sorted(scenes_by_room.items()):
            items.append({"room": room_name, "scenes": sorted(scene_names)})
        json_out(items, args.quiet)
    else:
        for room_name in sorted(scenes_by_room.keys()):
            print(f"\n{room_name}:")
            for sn in sorted(scenes_by_room[room_name]):
                print(f"  {sn}")
        if not scenes_by_room:
            print("No scenes found.")


def cmd_status(args):
    """Show detail for one target, or everything."""
    snap = _get_snap(args)

    if args.target:
        targets = resolve_targets(args.target, snap)
        json_rows = []
        rows = []
        for t in targets:
            r = snap["rid_index"].get(t["id"])
            if not r:
                continue
            if args.json:
                json_rows.append(trim_resource({"id": t["id"], **r}, snap))
            else:
                _print_status_line(t, r, snap)
        if args.json:
            json_out(json_rows, args.quiet)
    else:
        # Show everything
        if args.json:
            items = []
            for r in snap["rooms"]:
                items.append(trim_resource({"id": r["id"], **r}, snap))
            for l in snap["lights"]:
                items.append(trim_resource({"id": l["id"], **l}, snap))
            for z in snap["zones"]:
                items.append(trim_resource({"id": z["id"], **z}, snap))
            json_out(items, args.quiet)
        else:
            if snap["rooms"]:
                print("Rooms:")
                for r in snap["rooms"]:
                    t = {"type": "room", "id": r["id"], "name": r.get("metadata", {}).get("name", ""),
                         "grouped_light_id": snap["gl_by_owner"].get(r["id"], {}).get("id") if snap["gl_by_owner"].get(r["id"]) else None}
                    _print_status_line(t, r, snap)
            if snap["lights"]:
                print("\nLights:")
                for l in snap["lights"]:
                    t = {"type": "light", "id": l["id"], "name": l.get("metadata", {}).get("name", ""), "grouped_light_id": None}
                    _print_status_line(t, l, snap)


def _print_status_line(target, resource, snap):
    """Print one status line for a target."""
    name = target.get("name") or resource.get("metadata", {}).get("name", "?")
    rtype = target.get("type") or resource.get("type", "?")

    if rtype == "room" or rtype == "zone":
        gl = snap["gl_by_owner"].get(target["id"])
        if gl:
            on_state, any_on = get_gl_on(gl)
            state = "on" if any_on else "off"
            bri = get_light_brightness(gl)
            line = f"  {name} ({rtype}): {state}"
            if bri is not None:
                line += f", {format_bri(bri)}"
            print(line)
        else:
            print(f"  {name} ({rtype}): no grouped_light")
    elif rtype == "light":
        on_state = get_light_on(resource)
        bri = get_light_brightness(resource)
        ct = get_light_color_temp(resource)
        xy = get_light_color(resource)
        reachable = resource.get("light", {}).get("is_reachable", True)
        state = "on" if on_state else "off"
        line = f"  {name} (light): {state}"
        if bri is not None:
            line += f", {format_bri(bri)}"
        if ct is not None:
            line += f", {format_ct(ct)}"
        if xy and xy != (0.0, 0.0):
            line += f", xy=({xy[0]}, {xy[1]})"
        if not reachable:
            line += " [unreachable]"
        print(line)


def cmd_on(args):
    """Turn target(s) on."""
    snap = _get_snap(args)
    targets = resolve_targets(args.target, snap)
    _do_mutation_with_targets([(t, True) for t in targets], None, args, snap=snap)


def cmd_off(args):
    """Turn target(s) off."""
    snap = _get_snap(args)
    targets = resolve_targets(args.target, snap)
    _do_mutation_with_targets([(t, False) for t in targets], None, args, snap=snap)


def cmd_toggle(args):
    """Toggle target(s)."""
    snap = _get_snap(args)
    targets = resolve_targets(args.target, snap)
    toggle_list = []
    for t in targets:
        r = snap["rid_index"].get(t["id"])
        if t["grouped_light_id"]:
            gl_id = t["grouped_light_id"]
            gl = snap["rid_index"].get(gl_id)
            _, any_on = get_gl_on(gl)
            toggle_list.append((t, not any_on if any_on is not None else True))
        else:
            on_state = get_light_on(r)
            toggle_list.append((t, not on_state if on_state is not None else True))
    _do_mutation_with_targets(toggle_list, None, args, snap=snap)


def cmd_set(args):
    """Set properties on target(s)."""
    snap = _get_snap(args)
    targets = resolve_targets(args.target, snap)
    _do_mutation_with_targets([(t, None) for t in targets], args, args, snap=snap)


def _do_mutation_with_targets(targets_with_state, set_args, args, snap=None):
    """Apply mutation to resolved targets.

    targets_with_state: list of (target_dict, override_on_state_or_None)
    """
    if snap is None:
        snap = _get_snap(args)
    results = []

    for target, override_on in targets_with_state:
        body = {}

        if override_on is not None:
            body["on"] = {"on": override_on}
        elif set_args:
            if getattr(set_args, 'set_on', None):
                body["on"] = {"on": True}
            elif getattr(set_args, 'set_off', None):
                body["on"] = {"on": False}

        if set_args and set_args.brightness is not None:
            bri = max(0, min(100, set_args.brightness))
            body.setdefault("dimming", {})
            body["dimming"]["brightness"] = bri

        if set_args and set_args.color_temp is not None:
            mirek = kelvin_to_mirek(set_args.color_temp)
            body.setdefault("color_temperature", {})
            body["color_temperature"]["mirek"] = mirek

        if set_args and set_args.color is not None:
            xy = parse_color(set_args.color)
            if xy is None:
                die(3, f'Unknown colour "{set_args.color}". Use a CSS name or #rrggbb.')
            body.setdefault("color", {})
            body["color"]["xy"] = {"x": xy[0], "y": xy[1]}

        if set_args and set_args.transition is not None:
            body["dynamics"] = {"duration": set_args.transition}

        if not body:
            die(2, "No properties to set. Use --on/--off/--bri/--ct/--color/--transition.")

        # PUT to the right endpoint
        if target["grouped_light_id"]:
            ep = f"grouped_light/{target['grouped_light_id']}"
        else:
            ep = f"light/{target['id']}"

        request("PUT", ep, body=body, bridge=args.bridge, key=args.key, timeout=args.timeout)

        # Re-read state
        _, resp = request("GET", ep, bridge=args.bridge, key=args.key, timeout=args.timeout)
        updated = resp["data"][0] if resp and resp.get("data") else {}

        results.append((target, updated))

    # Output
    if args.json:
        json_rows = []
        for target, updated in results:
            json_rows.append(trim_resource({"id": target["id"], **updated}, snap))
        json_out(json_rows, args.quiet)
    elif not args.quiet:
        for target, updated in results:
            name = target["name"]
            if target["grouped_light_id"]:
                _, any_on = get_gl_on(updated)
                state = "on" if any_on else "off"
                bri = get_light_brightness(updated)
            else:
                on_state = get_light_on(updated)
                state = "on" if on_state else "off"
                bri = get_light_brightness(updated)
            line = f"  {name}: {state}"
            if bri is not None:
                line += f", {format_bri(bri)}"
            print(line)


def cmd_scene(args):
    """Activate a scene."""
    snap = _get_snap(args)
    name = args.scene
    room_filter = args.room
    room_id = None

    if room_filter:
        # Resolve room name to id
        room_results = resolve_name(room_filter, snap)
        room_filter_objs = [r for r in room_results if r["type"] == "room"]
        if not room_filter_objs:
            die(3, f'No room named "{room_filter}".')
        room_id = room_filter_objs[0]["id"]

    scenes = _resolve_scene_name(name, snap, room_filter=room_id)

    if not scenes:
        # Try without room filter
        scenes = _resolve_scene_name(name, snap, room_filter=None)
        if len(scenes) > 1:
            rooms_list = ", ".join(sorted(set(s["room_name"] for s in scenes)))
            die(3, f'Scene "{name}" is ambiguous (found in: {rooms_list}). Use --room to specify.')
        elif not scenes:
            die(3, f'No scene named "{name}".')

    scene = scenes[0]
    body = {"recall": {"action": "active"}}
    request("PUT", f"scene/{scene['id']}", body=body, bridge=args.bridge, key=args.key, timeout=args.timeout)

    if not args.quiet:
        print(f"  Scene '{scene['name']}' activated in {scene['room_name']}")


