def _get_snap(args):
    """Get a snapshot, sharing cached result within the call."""
    bridge, key = args.bridge, args.key
    if not bridge or not key:
        cfg = load_config(bridge, key)
        bridge = cfg["bridge"]
        key = cfg["key"]
        args.bridge = bridge
        args.key = key
    if not bridge:
        die(4, "No bridge configured. Run 'hue pair --bridge <IP>' first.")
    if not key:
        die(4, "No key configured. Run 'hue pair --bridge <IP>' first.")
    return snapshot(bridge, key, args.timeout)


