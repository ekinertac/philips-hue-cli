def load_config(bridge=None, key=None):
    """Load config from file or env, with CLI overrides."""
    cfg = {"bridge": None, "key": None}

    # Env overrides
    env_bridge = os.environ.get("HUE_BRIDGE")
    env_config = os.environ.get("HUE_CONFIG")

    config_file = env_config or CONFIG_PATH
    if config_file and Path(config_file).exists():
        try:
            data = json.loads(Path(config_file).read_text())
            cfg.update(data)
        except (json.JSONDecodeError, OSError):
            pass

    if env_bridge:
        cfg["bridge"] = env_bridge

    # CLI overrides
    if bridge:
        cfg["bridge"] = bridge
    if key:
        cfg["key"] = key

    return cfg


def save_config(bridge, key):
    """Write config file with mode 0600."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    data = json.dumps({"bridge": bridge, "key": key}, indent=2)
    path = str(CONFIG_PATH)
    urandom = "/dev/urandom" if sys.platform != "win32" else None

    # Write to temp then rename for atomicity
    tmp = Path(str(CONFIG_PATH) + ".tmp")
    tmp.write_text(data)
    tmp.chmod(CONFIG_MODE)
    tmp.rename(CONFIG_PATH)


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

def _ctx():
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def request(method, path, body=None, bridge=None, key=None, timeout=5, v2=True):
    """Make an HTTPS request to the bridge.

    Returns (status_code, parsed_json_body_or_None).
    Raises SystemExit on connection errors.
    """
    url = f"https://{bridge}/clip/v2/resource/{path}" if v2 else f"https://{bridge}/api"
    headers = {"Content-Type": "application/json"}
    if v2 and key:
        headers["hue-application-key"] = key

    data = None
    if body is not None:
        data = json.dumps(body).encode()

    try:
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        resp = urllib.request.urlopen(req, context=_ctx(), timeout=timeout)
        raw = resp.read()
        code = resp.status
    except urllib.error.HTTPError as e:
        code = e.code
        raw = e.read()
    except urllib.error.URLError as e:
        msg = str(e.reason)
        if "timed out" in msg:
            die(1, f"Bridge at {bridge} timed out after {timeout}s")
        die(1, f"Cannot reach bridge at {bridge}: {msg}")
    except OSError as e:
        die(1, f"Cannot reach bridge at {bridge}: {e}")

    try:
        parsed = json.loads(raw) if raw else None
    except json.JSONDecodeError:
        parsed = None

    # Translate v2 errors in response body
    if parsed and isinstance(parsed, dict) and parsed.get("errors"):
        errs = parsed["errors"]
        for e in errs:
            desc = e.get("description", str(e))
            if code == 401:
                die(4, f"Key rejected by bridge. Run 'hue pair' to get a new key: {desc}")
            die(1, f"Bridge error: {desc}")

    if code == 401:
        die(4, "Key rejected by bridge. Run 'hue pair' to get a new key.")

    if code >= 400:
        die(1, f"HTTP {code} from bridge: {raw[:200].decode(errors='replace')}")

    return code, parsed


# ---------------------------------------------------------------------------
# Colour conversion
# ---------------------------------------------------------------------------

def kelvin_to_mirek(k):
    """Convert Kelvin to mirek (microreciprocal), truncating as the bridge does."""
    k = max(2000, min(6500, k))
    return int(1_000_000 / k)


def mirek_to_kelvin(m):
    """Convert mirek to Kelvin."""
    return int(round(1_000_000 / m))


def css_color_to_rgb(name):
    """Look up a CSS colour name → (R, G, B) 0–255 or None."""
    return CSS_COLORS.get(name.lower().replace(" ", ""))


def hex_to_rgb(hex_str):
    """Parse #rrggbb or rrggbb → (R, G, B) 0–255 or None."""
    h = hex_str.lstrip("#")
    if len(h) != 6:
        return None
    try:
        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
    except ValueError:
        return None


def rgb_to_xy(r, g, b):
    """Convert sRGB (0–255) to CIE 1931 xy (x, y) with Y ≈ brightness.

    Returns (x, y) floats in 0–1 range.
    """
    # Normalise and linearise (gamma correction)
    rl = _linearize(r / 255.0)
    gl = _linearize(g / 255.0)
    bl = _linearize(b / 255.0)

    # sRGB → XYZ
    x = rl * SRGB_TO_XYZ[0][0] + gl * SRGB_TO_XYZ[0][1] + bl * SRGB_TO_XYZ[0][2]
    y = rl * SRGB_TO_XYZ[1][0] + gl * SRGB_TO_XYZ[1][1] + bl * SRGB_TO_XYZ[1][2]
    z = rl * SRGB_TO_XYZ[2][0] + gl * SRGB_TO_XYZ[2][1] + bl * SRGB_TO_XYZ[2][2]

    total = x + y + z
    if total == 0:
        return (0.0, 0.0)

    return (round(x / total, 6), round(y / total, 6))


def _linearize(c):
    """sRGB gamma correction: linearise a single channel."""
    if c <= 0.04045:
        return c / 12.92
    return ((c + 0.055) / 1.055) ** 2.4


def parse_color(color_str):
    """Parse a CSS name or #rrggbb → CIE xy tuple or None."""
    if color_str.startswith("#") or (len(color_str) == 6 and all(c in "0123456789abcdefABCDEF" for c in color_str)):
        rgb = hex_to_rgb(color_str)
    else:
        rgb = css_color_to_rgb(color_str)
    if rgb is None:
        return None
    return rgb_to_xy(*rgb)


def format_bri(b):
    """Format brightness value from bridge (0–100 float) as % string."""
    if b is None:
        return "-"
    return f"{round(b)}%"


def format_ct(mirek):
    """Format mirek as Kelvin string."""
    if mirek is None:
        return "-"
    return f"{mirek_to_kelvin(mirek)}K"


# ---------------------------------------------------------------------------
# Snapshot: fetch all resources and join them
# ---------------------------------------------------------------------------

def snapshot(bridge, key, timeout):
    """Fetch all v2 resources and return a joined lookup dict.

    Returns {
        "lights": [...],       # raw resources
        "rooms": [...],
        "zones": [...],
        "grouped_lights": [...],
        "scenes": [...],
        "devices": [...],
        # Derived maps
        "rid_index": {rid: resource},              # all resources keyed by id
        "gl_by_owner": {owner_id: grouped_light},  # grouped_light → its parent (room/zone)
        "light_device": {light_id: device_id},
        "device_by_id": {device_id: device},
    }
    """
    data = {}
    for rtype in V2_TYPES:
        _, resp = request("GET", rtype, bridge=bridge, key=key, timeout=timeout)
        data[rtype] = resp.get("data", []) if resp else []

    # Build rid_index
    rid_index = {}
    for rtype in V2_TYPES:
        for r in data[rtype]:
            rid_index[r["id"]] = r

    # Grouped lights → owner mapping (owner = room/zone that has this gl in services)
    gl_by_owner = {}
    for room in data["room"]:
        for svc in room.get("services", []):
            if svc["rtype"] == "grouped_light":
                gl_by_owner[room["id"]] = rid_index.get(svc["rid"])
    for zone in data["zone"]:
        for svc in zone.get("services", []):
            if svc["rtype"] == "grouped_light":
                gl_by_owner[zone["id"]] = rid_index.get(svc["rid"])

    # Light → device mapping (device has services with rtype=light)
    light_device = {}
    device_by_id = {}
    for dev in data["device"]:
        device_by_id[dev["id"]] = dev
        for svc in dev.get("services", []):
            if svc["rtype"] == "light":
                light_device[svc["rid"]] = dev["id"]

    return {
        "lights": data["light"],
        "rooms": data["room"],
        "zones": data["zone"],
        "grouped_lights": data["grouped_light"],
        "scenes": data["scene"],
        "devices": data["device"],
        "rid_index": rid_index,
        "gl_by_owner": gl_by_owner,
        "light_device": light_device,
        "device_by_id": device_by_id,
    }


def get_light_brightness(light):
    """Extract brightness percent from a light resource (0–100 int)."""
    d = light.get("dimming", {})
    return d.get("brightness")


def get_light_on(light):
    """Extract on/off state from a light resource."""
    o = light.get("on", {})
    return o.get("on")


def get_light_color_temp(light):
    """Extract mirek from a light resource."""
    ct = light.get("color_temperature", {})
    return ct.get("mirek")


def get_light_color(light):
    """Extract CIE xy from a light resource."""
    c = light.get("color", {})
    xy = c.get("xy")
    if xy:
        return (xy.get("x"), xy.get("y"))
    return None


def get_gl_on(gl):
    """Get the any_on/all_on state from a grouped_light.

    any_on is optional in the v2 API; falls back to on.on.
    """
    if gl is None:
        return None, None
    on = gl.get("on", {}).get("on")
    any_on = gl.get("on", {}).get("any_on", on)
    return on, any_on


# ---------------------------------------------------------------------------
# Resolver
# ---------------------------------------------------------------------------

def resolve_name(name, snap, room_filter=None, scene_only=False):
    """Resolve a name to one or more targets.

    Case-insensitive. Checks rooms first, then lights, then zones.
    Returns list of {"type", "id", "name", "grouped_light_id"}.
    Empty list if not found.
    """
    if scene_only:
        return _resolve_scene_name(name, snap, room_filter)

    nl = name.lower()
    results = []

    # Rooms
    for r in snap["rooms"]:
        if r.get("metadata", {}).get("name", "").lower() == nl:
            gl = snap["gl_by_owner"].get(r["id"])
            results.append({
                "type": "room",
                "id": r["id"],
                "name": r.get("metadata", {}).get("name", ""),
                "grouped_light_id": gl["id"] if gl else None,
            })

    # Lights
    for l in snap["lights"]:
        dev_id = snap["light_device"].get(l["id"])
        dev = snap["device_by_id"].get(dev_id) if dev_id else None
        lname = l.get("metadata", {}).get("name", "")
        if not lname and dev:
            lname = dev.get("product_name", "")
        if lname.lower() == nl:
            results.append({
                "type": "light",
                "id": l["id"],
                "name": lname,
                "grouped_light_id": None,
            })

    # Zones
    for z in snap["zones"]:
        if z.get("metadata", {}).get("name", "").lower() == nl:
            gl = snap["gl_by_owner"].get(z["id"])
            results.append({
                "type": "zone",
                "id": z["id"],
                "name": z.get("metadata", {}).get("name", ""),
                "grouped_light_id": gl["id"] if gl else None,
            })

    return results


def _resolve_scene_name(name, snap, room_filter=None):
    """Resolve a scene name within room scope."""
    nl = name.lower()
    results = []

    for s in snap["scenes"]:
        sname = s.get("metadata", {}).get("name", "")
        if sname.lower() != nl:
            continue
        group = s.get("group", {})
        room_id = group.get("rid")
        if room_filter and room_id != room_filter:
            continue
        if room_filter is None:
            # Check uniqueness
            pass
        results.append({
            "type": "scene",
            "id": s["id"],
            "name": sname,
            "room_id": room_id,
            "room_name": snap["rid_index"].get(room_id, {}).get("metadata", {}).get("name", "") if room_id else "",
        })

    return results


def resolve_targets(target_strs, snap):
    """Resolve one or more target strings → list of target dicts.

    Handles 'all' and UUIDs directly.
    """
    targets = []
    for t in target_strs:
        if t == "all":
            for r in snap["rooms"]:
                gl = snap["gl_by_owner"].get(r["id"])
                targets.append({
                    "type": "room",
                    "id": r["id"],
                    "name": r.get("metadata", {}).get("name", ""),
                    "grouped_light_id": gl["id"] if gl else None,
                })
            continue

        # Try as UUID (any id in rid_index)
        r = snap["rid_index"].get(t)
        if r:
            rtype = r.get("type", "")
            if rtype == "room":
                gl = snap["gl_by_owner"].get(t)
                targets.append({"type": "room", "id": t, "name": r.get("metadata", {}).get("name", t), "grouped_light_id": gl["id"] if gl else None})
            elif rtype == "zone":
                gl = snap["gl_by_owner"].get(t)
                targets.append({"type": "zone", "id": t, "name": r.get("metadata", {}).get("name", t), "grouped_light_id": gl["id"] if gl else None})
            elif rtype == "light":
                targets.append({"type": "light", "id": t, "name": r.get("metadata", {}).get("name", t), "grouped_light_id": None})
            elif rtype == "grouped_light":
                for oid, gl in snap["gl_by_owner"].items():
                    if gl and gl["id"] == t:
                        owner = snap["rid_index"].get(oid)
                        targets.append({"type": owner.get("type", "room") if owner else "room", "id": oid, "name": owner.get("metadata", {}).get("name", t) if owner else t, "grouped_light_id": t})
                        break
            else:
                targets.append({"type": rtype, "id": t, "name": r.get("metadata", {}).get("name", t), "grouped_light_id": None})
            continue

        # Name resolution
        results = resolve_name(t, snap)
        if results:
            targets.extend(results)
        else:
            # Try close matches
            all_names = []
            for r in snap["rooms"]:
                all_names.append(r.get("metadata", {}).get("name", ""))
            for l in snap["lights"]:
                lname = l.get("metadata", {}).get("name", "")
                if not lname:
                    dev_id = snap["light_device"].get(l["id"])
                    dev = snap["device_by_id"].get(dev_id) if dev_id else None
                    if dev:
                        lname = dev.get("product_name", "")
                all_names.append(lname)
            for z in snap["zones"]:
                all_names.append(z.get("metadata", {}).get("name", ""))

            matches = difflib.get_close_matches(t, [n for n in all_names if n], n=5, cutoff=0.5)
            if matches:
                did_you = f" Did you mean: {', '.join(matches)}?"
            else:
                did_you = ""
            die(3, f'No target named "{t}".{did_you}')

    return targets


