def trim_resource(r, snap):
    """Trim a resource to the standard --json fields."""
    tid = r["id"]
    obj = {"id": tid, "name": r.get("metadata", {}).get("name", ""), "type": r.get("type", "")}

    if r.get("type") in ("light",):
        obj["on"] = get_light_on(r)
        obj["brightness"] = get_light_brightness(r)
        ct = get_light_color_temp(r)
        obj["color_temperature"] = mirek_to_kelvin(ct) if ct else None
        xy = get_light_color(r)
        obj["color"] = {"x": xy[0], "y": xy[1]} if xy else None
        # Find room
        obj["room"] = None
        for room in snap["rooms"]:
            for svc in room.get("services", []):
                if svc["rtype"] == "light" and svc["rid"] == tid:
                    obj["room"] = room.get("metadata", {}).get("name", "")
                    break

    elif r.get("type") in ("room", "zone"):
        gl = snap["gl_by_owner"].get(tid)
        if gl:
            _, any_on = get_gl_on(gl)
            obj["on"] = any_on
            obj["brightness"] = get_light_brightness(gl) if gl.get("dimming") else None
        obj["light_count"] = len([s for s in r.get("services", []) if s["rtype"] == "light"])

    elif r.get("type") in ("grouped_light",):
        on_state, any_on = get_gl_on(r)
        obj["on"] = on_state if on_state is not None else any_on
        obj["brightness"] = get_light_brightness(r)

    return obj


def fmt_table(rows, headers):
    """Print a left-aligned table of rows (list of lists)."""
    if not rows:
        return
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(str(cell)))
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format(*headers))
    print(fmt.format(*("-" * w for w in widths)))
    for row in rows:
        print(fmt.format(*row))


def json_out(items, quiet=False):
    """Print items as JSON array."""
    if quiet:
        return
    print(json.dumps(items, indent=2, default=str))


