def main():
    parser = argparse.ArgumentParser(
        prog="hue",
        description="Control Philips Hue lights from the command line.",
        epilog=(
            "Examples:\n"
            "  hue pair --bridge 192.168.1.100    Pair with the bridge\n"
            "  hue lights                         List all lights\n"
            "  hue on desk                        Turn the 'desk' room on\n"
            "  hue off desk                       Turn it off\n"
            "  hue set desk --bri 50 --ct 4000    Dim to 50%, warm white\n"
            "  hue set desk --color coral         Set colour\n"
            "  hue scene bright --room office     Activate scene\n"
            "  hue status --json                  Everything as JSON\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # Global flags
    parser.add_argument("--bridge", help="Bridge IP address")
    parser.add_argument("--key", help="Application key")
    parser.add_argument("--timeout", type=int, default=5, help="HTTP timeout in seconds (default: 5)")
    parser.add_argument("--json", action="store_true", help="Output JSON")
    parser.add_argument("-q", "--quiet", action="store_true", help="Suppress normal output")
    parser.add_argument("--version", action="version", version="hue 0.1")

    sub = parser.add_subparsers(dest="cmd", required=True)

    # pair
    p_pair = sub.add_parser("pair", help="Pair with a Hue bridge")
    p_pair.add_argument("--bridge", dest="pair_bridge", help="Bridge IP (optional: auto-discover)")

    # lights
    sub.add_parser("lights", help="List lights")

    # rooms
    sub.add_parser("rooms", help="List rooms")

    # scenes
    p_scenes = sub.add_parser("scenes", help="List scenes")
    p_scenes.add_argument("room", nargs="?", default=None, help="Filter by room name")

    # status
    p_status = sub.add_parser("status", help="Show status of targets or everything")
    p_status.add_argument("target", nargs="*", default=None, help="Target names (omit for all)")

    # on
    p_on = sub.add_parser("on", help="Turn target(s) on")
    p_on.add_argument("target", nargs="+", help="Target names")

    # off
    p_off = sub.add_parser("off", help="Turn target(s) off")
    p_off.add_argument("target", nargs="+", help="Target names")

    # toggle
    p_toggle = sub.add_parser("toggle", help="Toggle target(s)")
    p_toggle.add_argument("target", nargs="+", help="Target names")

    # set
    p_set = sub.add_parser("set", help="Set properties on target(s)")
    p_set.add_argument("target", nargs="+", help="Target names")
    p_set.add_argument("--bri", dest="brightness", type=int, help="Brightness 1-100")
    p_set.add_argument("--ct", type=int, dest="color_temp", help="Color temperature in Kelvin (2000-6500)")
    p_set.add_argument("--color", help="CSS color name or #rrggbb")
    p_set.add_argument("--on", dest="set_on", action="store_true", default=None, help="Turn on")
    p_set.add_argument("--off", dest="set_off", action="store_true", default=None, help="Turn off")
    p_set.add_argument("--transition", type=int, help="Transition duration in ms")

    # scene
    p_scene = sub.add_parser("scene", help="Activate a scene")
    p_scene.add_argument("scene", help="Scene name")
    p_scene.add_argument("--room", help="Room name (required if ambiguous)")

    args = parser.parse_args()

    # Propagate global args to subcommand args
    args.bridge = getattr(args, "pair_bridge", None) or args.bridge
    args.key = args.key
    args.timeout = args.timeout
    args.json = args.json
    args.quiet = args.quiet

    # Route
    cmd_map = {
        "pair": cmd_pair,
        "lights": cmd_lights,
        "rooms": cmd_rooms,
        "scenes": cmd_scenes,
        "status": cmd_status,
        "on": cmd_on,
        "off": cmd_off,
        "toggle": cmd_toggle,
        "set": cmd_set,
        "scene": cmd_scene,
    }

    cmd_map[args.cmd](args)


if __name__ == "__main__":
    main()